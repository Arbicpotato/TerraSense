<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_bg">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/widget_badge"
            android:gravity="center"
            android:text="🌿"
            android:textSize="17sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="TerraSense"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#9CE37D"
                android:textSize="10sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/widget_dots"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:textColor="#FFFFFF"
            android:textSize="9sp" />

        <TextView
            android:id="@+id/widget_prev"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:background="@drawable/widget_circle"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/widget_next"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_circle"
            android:gravity="center"
            android:text="›"
            android:textColor="#FFFFFF"
            android:textSize="20sp" />
    </LinearLayout>

    <!--
      Body: fills all the space under the header. Every section is wrap_content + a weight, so any
      spare height is shared out between the visible sections instead of being left empty.
    -->
    <LinearLayout
        android:id="@+id/widget_body"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="8dp">

        <!-- Readings -->
        <LinearLayout
            android:id="@+id/widget_chips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1.4"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_chip_temp"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">
                <TextView android:id="@+id/ic_temp" style="@style/TsIcon" android:text="🌡️" />
                <TextView android:id="@+id/widget_temp" style="@style/TsValue" />
                <TextView style="@style/TsLabel" android:text="Temp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_chip_hum"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">
                <TextView android:id="@+id/ic_hum" style="@style/TsIcon" android:text="💧" />
                <TextView android:id="@+id/widget_hum" style="@style/TsValue" />
                <TextView style="@style/TsLabel" android:text="Humidity" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:background="@drawable/widget_chip_soil"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">
                <TextView android:id="@+id/ic_soil" style="@style/TsIcon" android:text="🌱" />
                <TextView android:id="@+id/widget_soil" style="@style/TsValue" />
                <TextView style="@style/TsLabel" android:text="Soil" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/widget_chip_lux"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">
                <TextView android:id="@+id/ic_lux" style="@style/TsIcon" android:text="☀️" />
                <TextView android:id="@+id/widget_lux" style="@style/TsValue" />
                <TextView style="@style/TsLabel" android:text="Lux" />
            </LinearLayout>
        </LinearLayout>

        <!-- Plant cycle -->
        <LinearLayout
            android:id="@+id/widget_cycle_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_weight="0.6"
            android:background="@drawable/widget_cycle_bg"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_cycle_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_cycle_day"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="#C8F0A8"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/widget_cycle_bar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:max="100"
                android:progressDrawable="@drawable/widget_progress" />

            <TextView
                android:id="@+id/widget_cycle_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="#B3FFFFFF"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Device buttons (tap to switch in Manual mode) + live status strip -->
        <LinearLayout
            android:id="@+id/widget_actions_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_weight="0.9"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
            <LinearLayout
                android:id="@+id/act_water"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💧" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Water" android:textColor="#FFFFFF" android:textSize="8sp" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/act_cool"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="❄️" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cooling" android:textColor="#FFFFFF" android:textSize="8sp" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/act_heat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔥" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Heating" android:textColor="#FFFFFF" android:textSize="8sp" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/act_humid"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💨" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Humidify" android:textColor="#FFFFFF" android:textSize="8sp" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/act_light"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💡" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lights" android:textColor="#FFFFFF" android:textSize="8sp" android:maxLines="1" />
            </LinearLayout>
            <LinearLayout
                android:id="@+id/act_fert"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingTop="5dp"
                android:paddingBottom="5dp">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🧪" android:textSize="15sp" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Feed" android:textColor="#FFFFFF" android:textSize="8sp" android:maxLines="1" />
            </LinearLayout>
            </LinearLayout>

            <!-- Status strip: what the hub is doing now, plus the top alert if there is one -->
            <LinearLayout
                android:id="@+id/widget_pill"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/widget_status_ok"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingLeft="12dp"
                android:paddingTop="5dp"
                android:paddingRight="12dp"
                android:paddingBottom="5dp">

                <TextView
                    android:id="@+id/widget_action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:maxLines="1"
                    android:textColor="#C8F0A8"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_alert"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:gravity="end"
                    android:maxLines="1"
                    android:textColor="#FFD180"
                    android:textSize="10sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Tank and fertilizer levels -->
        <LinearLayout
            android:id="@+id/widget_res_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_weight="0.5"
            android:background="@drawable/widget_cycle_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingTop="8dp"
            android:paddingRight="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="14dp"
                android:layout_weight="1"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView style="@style/TsResLabel" android:text="💧 Water tank" />
                    <TextView android:id="@+id/res_water_val" style="@style/TsResValue" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/res_water_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="5dp"
                    android:max="100"
                    android:progressDrawable="@drawable/widget_progress_water" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView style="@style/TsResLabel" android:text="🧪 Fertilizer" />
                    <TextView android:id="@+id/res_feed_val" style="@style/TsResValue" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/res_feed_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="6dp"
                    android:layout_marginTop="5dp"
                    android:max="100"
                    android:progressDrawable="@drawable/widget_progress_feed" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
