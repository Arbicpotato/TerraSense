<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/pet_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@drawable/widget_bg">

    <TextView
        android:id="@+id/pet_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ViewFlipper
            android:id="@+id/pf0"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoStart="true"
            android:flipInterval="100"
            android:visibility="gone">
            <ImageView android:id="@+id/pf0_0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf0_1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf0_2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf0_3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf0_4" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf0_5" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf0_6" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf0_7" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
        </ViewFlipper>

        <ViewFlipper
            android:id="@+id/pf1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoStart="true"
            android:flipInterval="160"
            android:visibility="gone">
            <ImageView android:id="@+id/pf1_0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf1_1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf1_2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf1_3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf1_4" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf1_5" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf1_6" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf1_7" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
        </ViewFlipper>

        <ViewFlipper
            android:id="@+id/pf2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoStart="true"
            android:flipInterval="200"
            android:visibility="gone">
            <ImageView android:id="@+id/pf2_0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf2_1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf2_2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf2_3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf2_4" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf2_5" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf2_6" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf2_7" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
        </ViewFlipper>

        <ViewFlipper
            android:id="@+id/pf3"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoStart="true"
            android:flipInterval="330"
            android:visibility="gone">
            <ImageView android:id="@+id/pf3_0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf3_1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf3_2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf3_3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf3_4" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf3_5" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf3_6" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf3_7" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
        </ViewFlipper>

        <ViewFlipper
            android:id="@+id/pf4"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:autoStart="true"
            android:flipInterval="500"
            android:visibility="gone">
            <ImageView android:id="@+id/pf4_0" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf4_1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf4_2" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf4_3" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf4_4" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf4_5" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf4_6" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
            <ImageView android:id="@+id/pf4_7" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitCenter" />
        </ViewFlipper>

        <TextView
            android:id="@+id/pet_prev"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="start|center_vertical"
            android:background="@drawable/widget_circle"
            android:gravity="center"
            android:text="‹"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/pet_next"
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="end|center_vertical"
            android:background="@drawable/widget_circle"
            android:gravity="center"
            android:text="›"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:visibility="gone" />

    </FrameLayout>

    <TextView
        android:id="@+id/pet_msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/widget_pill"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:paddingStart="14dp"
        android:paddingTop="5dp"
        android:paddingEnd="14dp"
        android:paddingBottom="5dp"
        android:textColor="#FFFFFF"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/pet_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">
        <TextView android:id="@+id/pet_temp" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#E8F5D8" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/pet_hum" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#E8F5D8" android:textSize="12sp" android:textStyle="bold" />
        <TextView android:id="@+id/pet_soil" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:textColor="#E8F5D8" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>
</LinearLayout>
